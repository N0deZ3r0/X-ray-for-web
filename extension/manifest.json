{
  "manifest_version": 3,
  "name": "X-ray for web",
  "version": "0.1.0",
  "description": "__MSG_ext_description__",

  "minimum_chrome_version": "119",

  "default_locale": "en",

  "permissions": ["storage", "scripting", "sidePanel", "tabs", "webRequest"],

  "host_permissions": [],
  "optional_host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "ui/panel.html"
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_title": "X-ray for web",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "web_accessible_resources": []
}
