{
  "id": "yandex-webvisor",
  "title": {
    "ru": "Яндекс.Вебвизор — запись действий",
    "en": "Yandex.Webvisor — session recording"
  },
  "version": "2026-09",
  "note": {
    "ru": "Вебвизор пишет движения мыши, прокрутку, клики и ввод в поля. Это не разновидность аналитики, а запись сеанса, и показывается отдельной строкой.",
    "en": "Webvisor records mouse movement, scrolling, clicks and typing into fields. This is not a kind of analytics but a recording of your session, and it is shown on a line of its own."
  },
  "match": {
    "host": [
      "mc.yandex.ru",
      "mc.yandex.com",
      "*.mc.yandex.ru"
    ],
    "path": "^/webvisor/"
  },
  "extract": [
    {
      "from": "path",
      "pattern": "^/webvisor/(\\d+)",
      "names": [
        "counter"
      ]
    },
    {
      "from": "query"
    }
  ],
  "fields": {
    "counter": {
      "label": {
        "ru": "Номер счётчика, который ведёт запись",
        "en": "Number of the counter doing the recording"
      },
      "kind": "site-id",
      "confidence": "observed"
    },
    "page-url": {
      "label": {
        "ru": "Адрес записываемой страницы",
        "en": "Address of the page being recorded"
      },
      "kind": "page-url",
      "confidence": "observed"
    },
    "rn": {
      "label": {
        "ru": "Случайное число запроса",
        "en": "Random number for this request"
      },
      "kind": "nonce",
      "confidence": "observed"
    },
    "wv-part": {
      "label": {
        "ru": "Номер части записи",
        "en": "Chunk number of the recording"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "wv-type": {
      "label": {
        "ru": "Тип передаваемых данных записи",
        "en": "Type of recording data being sent"
      },
      "kind": "technical",
      "confidence": "observed"
    }
  },
  "unknown": "preserve"
}
