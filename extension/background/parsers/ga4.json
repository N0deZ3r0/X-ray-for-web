{
  "id": "ga4",
  "title": {
    "ru": "Google Analytics 4",
    "en": "Google Analytics 4"
  },
  "version": "2026-09",
  "match": {
    "host": [
      "*.google-analytics.com",
      "analytics.google.com",
      "*.analytics.google.com"
    ],
    "path": "^/g/collect"
  },
  "extract": [
    {
      "from": "query"
    },
    {
      "from": "body",
      "format": "lines-urlencoded"
    }
  ],
  "fields": {
    "tid": {
      "label": {
        "ru": "Идентификатор счётчика сайта",
        "en": "Site measurement id"
      },
      "kind": "site-id",
      "confidence": "documented",
      "note": {
        "ru": "Кому именно уходят данные",
        "en": "Exactly who the data goes to"
      }
    },
    "cid": {
      "label": {
        "ru": "Идентификатор вашего браузера",
        "en": "Your browser identifier"
      },
      "kind": "device-id",
      "confidence": "documented",
      "note": {
        "ru": "Берётся из куки _ga, живёт два года. Связывает все ваши визиты на этот сайт",
        "en": "Taken from the _ga cookie, lives two years. Ties together every visit you make to this site"
      }
    },
    "sid": {
      "label": {
        "ru": "Идентификатор сессии",
        "en": "Session identifier"
      },
      "kind": "session-id",
      "confidence": "documented"
    },
    "sct": {
      "label": {
        "ru": "Какая это по счёту ваша сессия",
        "en": "Which numbered session of yours this is"
      },
      "kind": "session-id",
      "confidence": "documented"
    },
    "uid": {
      "label": {
        "ru": "Ваш идентификатор в системе сайта",
        "en": "Your identifier in the site’s own system"
      },
      "kind": "user-id",
      "confidence": "documented",
      "note": {
        "ru": "Сайт передал собственный идентификатор пользователя — это связывает визит с вашей учётной записью",
        "en": "The site sent its own user id — this ties the visit to your account"
      }
    },
    "en": {
      "label": {
        "ru": "Название события",
        "en": "Event name"
      },
      "kind": "event-name",
      "confidence": "documented"
    },
    "dl": {
      "label": {
        "ru": "Адрес страницы",
        "en": "Page address"
      },
      "kind": "page-url",
      "confidence": "documented"
    },
    "dr": {
      "label": {
        "ru": "Откуда вы пришли",
        "en": "Where you came from"
      },
      "kind": "referrer",
      "confidence": "documented",
      "note": {
        "ru": "Предыдущая страница или поисковый запрос",
        "en": "The previous page or the search query"
      }
    },
    "dt": {
      "label": {
        "ru": "Заголовок страницы",
        "en": "Page title"
      },
      "kind": "page-title",
      "confidence": "documented"
    },
    "ul": {
      "label": {
        "ru": "Язык браузера",
        "en": "Browser language"
      },
      "kind": "language",
      "confidence": "documented"
    },
    "sr": {
      "label": {
        "ru": "Разрешение экрана",
        "en": "Screen resolution"
      },
      "kind": "screen",
      "confidence": "documented"
    },
    "_et": {
      "label": {
        "ru": "Сколько времени вы провели на странице, мс",
        "en": "How long you spent on the page, ms"
      },
      "kind": "timing",
      "confidence": "observed"
    },
    "v": {
      "label": {
        "ru": "Версия протокола",
        "en": "Protocol version"
      },
      "kind": "technical",
      "confidence": "documented"
    },
    "gtm": {
      "label": {
        "ru": "Версия контейнера Google Tag Manager",
        "en": "Google Tag Manager container version"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "_p": {
      "label": {
        "ru": "Случайное число этой загрузки",
        "en": "Random number for this load"
      },
      "kind": "nonce",
      "confidence": "observed"
    },
    "_s": {
      "label": {
        "ru": "Номер обращения в сессии",
        "en": "Hit number within the session"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "seg": {
      "label": {
        "ru": "Была ли сессия вовлечённой",
        "en": "Whether the session was engaged"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "_ss": {
      "label": {
        "ru": "Признак начала сессии",
        "en": "Session start flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "_fv": {
      "label": {
        "ru": "Признак первого визита",
        "en": "First visit flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "_nsi": {
      "label": {
        "ru": "Признак новой сессии",
        "en": "New session flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "_dbg": {
      "label": {
        "ru": "Режим отладки",
        "en": "Debug mode"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "are": {
      "label": {
        "ru": "Признак расширенных измерений",
        "en": "Enhanced measurement flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "frm": {
      "label": {
        "ru": "Обращение из фрейма",
        "en": "Hit from inside a frame"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "pscdl": {
      "label": {
        "ru": "Поддержка защищённых куки",
        "en": "Secure cookie support"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "tfd": {
      "label": {
        "ru": "Миллисекунд с загрузки страницы",
        "en": "Milliseconds since the page loaded"
      },
      "kind": "timing",
      "confidence": "observed"
    },
    "uaa": {
      "label": {
        "ru": "Архитектура процессора",
        "en": "CPU architecture"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Высокоэнтропийная подсказка User-Agent",
        "en": "High-entropy User-Agent hint"
      }
    },
    "uab": {
      "label": {
        "ru": "Разрядность системы",
        "en": "System bitness"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Высокоэнтропийная подсказка User-Agent",
        "en": "High-entropy User-Agent hint"
      }
    },
    "uap": {
      "label": {
        "ru": "Операционная система",
        "en": "Operating system"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Высокоэнтропийная подсказка User-Agent",
        "en": "High-entropy User-Agent hint"
      }
    },
    "uapv": {
      "label": {
        "ru": "Версия операционной системы",
        "en": "Operating system version"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Высокоэнтропийная подсказка User-Agent: сужает круг машин сильнее всего",
        "en": "High-entropy User-Agent hint: narrows the set of machines more than anything else"
      }
    },
    "uam": {
      "label": {
        "ru": "Модель устройства",
        "en": "Device model"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Высокоэнтропийная подсказка User-Agent",
        "en": "High-entropy User-Agent hint"
      }
    },
    "uamb": {
      "label": {
        "ru": "Мобильное ли устройство",
        "en": "Whether the device is mobile"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Подсказка User-Agent",
        "en": "User-Agent hint"
      }
    },
    "uafvl": {
      "label": {
        "ru": "Полный список версий браузера",
        "en": "Full list of browser versions"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Высокоэнтропийная подсказка User-Agent: точные версии всех компонентов",
        "en": "High-entropy User-Agent hint: exact versions of every component"
      }
    },
    "uaw": {
      "label": {
        "ru": "Режим совместимости WOW64",
        "en": "WOW64 compatibility mode"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Подсказка User-Agent",
        "en": "User-Agent hint"
      }
    },
    "gcd": {
      "label": {
        "ru": "Состояние согласия на сбор данных",
        "en": "Consent state for data collection"
      },
      "kind": "technical",
      "confidence": "observed",
      "note": {
        "ru": "Что именно вы разрешили или запретили в баннере согласия",
        "en": "Exactly what you allowed or refused in the consent banner"
      }
    },
    "npa": {
      "label": {
        "ru": "Отказ от персонализированной рекламы",
        "en": "Opt-out of personalised advertising"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "dma": {
      "label": {
        "ru": "Применяется ли европейский Digital Markets Act",
        "en": "Whether the European Digital Markets Act applies"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "dma_cps": {
      "label": {
        "ru": "Настройки согласия по Digital Markets Act",
        "en": "Digital Markets Act consent settings"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "tag_exp": {
      "label": {
        "ru": "Идентификаторы экспериментов Google Tag",
        "en": "Google Tag experiment identifiers"
      },
      "kind": "technical",
      "confidence": "observed"
    }
  },
  "patterns": [
    {
      "test": "^ep\\.",
      "label": {
        "ru": "Параметр события",
        "en": "Event parameter"
      },
      "kind": "event-param",
      "confidence": "documented"
    },
    {
      "test": "^epn\\.",
      "label": {
        "ru": "Числовой параметр события",
        "en": "Numeric event parameter"
      },
      "kind": "event-param",
      "confidence": "documented"
    },
    {
      "test": "^up\\.",
      "label": {
        "ru": "Свойство пользователя",
        "en": "User property"
      },
      "kind": "user-property",
      "confidence": "documented",
      "note": {
        "ru": "Сайт сам приписал вам это свойство и хранит его между визитами",
        "en": "The site assigned this property to you itself and keeps it between visits"
      }
    },
    {
      "test": "^upn\\.",
      "label": {
        "ru": "Числовое свойство пользователя",
        "en": "Numeric user property"
      },
      "kind": "user-property",
      "confidence": "documented"
    }
  ],
  "unknown": "preserve",
  "note": {
    "ru": "Google не публикует список параметров /g/collect. Поля с confidence \"documented\" известны из публичной документации gtag и наследия Universal Analytics; остальные получены наблюдением. Неизвестные поля показываются неизвестными — см. правило в 05-parsers.md.",
    "en": "Google does not publish the list of /g/collect parameters. Fields marked confidence \"documented\" are known from the public gtag documentation and from Universal Analytics; the rest come from observation. Unknown fields are shown as unknown — see the rule in docs/05-parsers.md."
  }
}
