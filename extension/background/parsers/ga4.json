{
  "id": "ga4",
  "title": "Google Analytics 4",
  "version": "2026-09",
  "match": {
    "host": [
      "*.google-analytics.com",
      "analytics.google.com",
      "*.analytics.google.com"
    ],
    "path": "^/g/collect"
  },
  "extract": [
    {
      "from": "query"
    },
    {
      "from": "body",
      "format": "lines-urlencoded"
    }
  ],
  "fields": {
    "tid": {
      "label": "Идентификатор счётчика сайта",
      "kind": "site-id",
      "confidence": "documented",
      "note": "Кому именно уходят данные"
    },
    "cid": {
      "label": "Идентификатор вашего браузера",
      "kind": "device-id",
      "confidence": "documented",
      "note": "Берётся из куки _ga, живёт два года. Связывает все ваши визиты на этот сайт"
    },
    "sid": {
      "label": "Идентификатор сессии",
      "kind": "session-id",
      "confidence": "documented"
    },
    "sct": {
      "label": "Какая это по счёту ваша сессия",
      "kind": "session-id",
      "confidence": "documented"
    },
    "uid": {
      "label": "Ваш идентификатор в системе сайта",
      "kind": "user-id",
      "confidence": "documented",
      "note": "Сайт передал собственный идентификатор пользователя — это связывает визит с вашей учётной записью"
    },
    "en": {
      "label": "Название события",
      "kind": "event-name",
      "confidence": "documented"
    },
    "dl": {
      "label": "Адрес страницы",
      "kind": "page-url",
      "confidence": "documented"
    },
    "dr": {
      "label": "Откуда вы пришли",
      "kind": "referrer",
      "confidence": "documented",
      "note": "Предыдущая страница или поисковый запрос"
    },
    "dt": {
      "label": "Заголовок страницы",
      "kind": "page-title",
      "confidence": "documented"
    },
    "ul": {
      "label": "Язык браузера",
      "kind": "language",
      "confidence": "documented"
    },
    "sr": {
      "label": "Разрешение экрана",
      "kind": "screen",
      "confidence": "documented"
    },
    "_et": {
      "label": "Сколько времени вы провели на странице, мс",
      "kind": "timing",
      "confidence": "observed"
    },
    "v": {
      "label": "Версия протокола",
      "kind": "technical",
      "confidence": "documented"
    },
    "gtm": {
      "label": "Версия контейнера Google Tag Manager",
      "kind": "technical",
      "confidence": "observed"
    },
    "_p": {
      "label": "Случайное число этой загрузки",
      "kind": "nonce",
      "confidence": "observed"
    },
    "_s": {
      "label": "Номер обращения в сессии",
      "kind": "technical",
      "confidence": "observed"
    },
    "seg": {
      "label": "Была ли сессия вовлечённой",
      "kind": "technical",
      "confidence": "observed"
    },
    "_ss": {
      "label": "Признак начала сессии",
      "kind": "technical",
      "confidence": "observed"
    },
    "_fv": {
      "label": "Признак первого визита",
      "kind": "technical",
      "confidence": "observed"
    },
    "_nsi": {
      "label": "Признак новой сессии",
      "kind": "technical",
      "confidence": "observed"
    },
    "_dbg": {
      "label": "Режим отладки",
      "kind": "technical",
      "confidence": "observed"
    },
    "are": {
      "label": "Признак расширенных измерений",
      "kind": "technical",
      "confidence": "observed"
    },
    "frm": {
      "label": "Обращение из фрейма",
      "kind": "technical",
      "confidence": "observed"
    },
    "pscdl": {
      "label": "Поддержка защищённых куки",
      "kind": "technical",
      "confidence": "observed"
    },
    "tfd": {
      "label": "Миллисекунд с загрузки страницы",
      "kind": "timing",
      "confidence": "observed"
    },
    "uaa": {
      "label": "Архитектура процессора",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Высокоэнтропийная подсказка User-Agent"
    },
    "uab": {
      "label": "Разрядность системы",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Высокоэнтропийная подсказка User-Agent"
    },
    "uap": {
      "label": "Операционная система",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Высокоэнтропийная подсказка User-Agent"
    },
    "uapv": {
      "label": "Версия операционной системы",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Высокоэнтропийная подсказка User-Agent: сужает круг машин сильнее всего"
    },
    "uam": {
      "label": "Модель устройства",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Высокоэнтропийная подсказка User-Agent"
    },
    "uamb": {
      "label": "Мобильное ли устройство",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Подсказка User-Agent"
    },
    "uafvl": {
      "label": "Полный список версий браузера",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Высокоэнтропийная подсказка User-Agent: точные версии всех компонентов"
    },
    "uaw": {
      "label": "Режим совместимости WOW64",
      "kind": "device-id",
      "confidence": "observed",
      "note": "Подсказка User-Agent"
    },
    "gcd": {
      "label": "Состояние согласия на сбор данных",
      "kind": "technical",
      "confidence": "observed",
      "note": "Что именно вы разрешили или запретили в баннере согласия"
    },
    "npa": {
      "label": "Отказ от персонализированной рекламы",
      "kind": "technical",
      "confidence": "observed"
    },
    "dma": {
      "label": "Применяется ли европейский Digital Markets Act",
      "kind": "technical",
      "confidence": "observed"
    },
    "dma_cps": {
      "label": "Настройки согласия по Digital Markets Act",
      "kind": "technical",
      "confidence": "observed"
    },
    "tag_exp": {
      "label": "Идентификаторы экспериментов Google Tag",
      "kind": "technical",
      "confidence": "observed"
    }
  },
  "patterns": [
    {
      "test": "^ep\\.",
      "label": "Параметр события",
      "kind": "event-param",
      "confidence": "documented"
    },
    {
      "test": "^epn\\.",
      "label": "Числовой параметр события",
      "kind": "event-param",
      "confidence": "documented"
    },
    {
      "test": "^up\\.",
      "label": "Свойство пользователя",
      "kind": "user-property",
      "confidence": "documented",
      "note": "Сайт сам приписал вам это свойство и хранит его между визитами"
    },
    {
      "test": "^upn\\.",
      "label": "Числовое свойство пользователя",
      "kind": "user-property",
      "confidence": "documented"
    }
  ],
  "unknown": "preserve",
  "note": "Google не публикует список параметров /g/collect. Поля с confidence \"documented\" известны из публичной документации gtag и наследия Universal Analytics; остальные получены наблюдением. Неизвестные поля показываются неизвестными — см. правило в 05-parsers.md."
}
