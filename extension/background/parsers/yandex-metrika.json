{
  "id": "yandex-metrika",
  "title": {
    "ru": "Яндекс.Метрика",
    "en": "Yandex.Metrica"
  },
  "version": "2026-09",
  "note": {
    "ru": "Яндекс не публикует список параметров /watch. Поля получены наблюдением. Начинка упакована в один параметр browser-info строкой вида «ключ:значение:ключ:значение» — движок разбирает её парами и останавливается, если разбор рассинхронизировался.",
    "en": "Yandex does not publish the list of /watch parameters. The fields come from observation. The payload is packed into a single browser-info parameter shaped like «key:value:key:value» — the engine unpacks it in pairs and stops as soon as the unpacking falls out of step."
  },
  "match": {
    "host": [
      "mc.yandex.ru",
      "mc.yandex.com",
      "*.mc.yandex.ru"
    ],
    "path": "^/watch/"
  },
  "extract": [
    {
      "from": "path",
      "pattern": "^/watch/(\\d+)",
      "names": [
        "counter"
      ]
    },
    {
      "from": "query"
    }
  ],
  "nested": [
    {
      "param": "browser-info",
      "format": "colon-pairs",
      "title": {
        "ru": "Что внутри browser-info",
        "en": "What is inside browser-info"
      }
    }
  ],
  "fields": {
    "counter": {
      "label": {
        "ru": "Номер счётчика Метрики",
        "en": "Metrica counter number"
      },
      "kind": "site-id",
      "confidence": "observed",
      "note": {
        "ru": "Кому именно уходят данные",
        "en": "Exactly who the data goes to"
      }
    },
    "page-url": {
      "label": {
        "ru": "Адрес страницы",
        "en": "Page address"
      },
      "kind": "page-url",
      "confidence": "observed"
    },
    "page-ref": {
      "label": {
        "ru": "Откуда вы пришли",
        "en": "Where you came from"
      },
      "kind": "referrer",
      "confidence": "observed"
    },
    "charset": {
      "label": {
        "ru": "Кодировка страницы",
        "en": "Page character encoding"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "browser-info": {
      "label": {
        "ru": "Упакованные сведения о браузере",
        "en": "Packed browser information"
      },
      "kind": "technical",
      "confidence": "observed",
      "note": {
        "ru": "Содержимое распаковано ниже отдельной группой",
        "en": "The contents are unpacked below as a separate group"
      }
    },
    "site-info": {
      "label": {
        "ru": "Параметры визита, заданные сайтом",
        "en": "Visit parameters set by the site"
      },
      "kind": "event-param",
      "confidence": "observed",
      "note": {
        "ru": "Сайт кладёт сюда что угодно — от раздела каталога до вашего статуса в его системе",
        "en": "The site puts anything it likes in here — from a catalogue section to your status in its own system"
      }
    },
    "ut": {
      "label": {
        "ru": "Признак отказа от отслеживания",
        "en": "Do-not-track flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "t": {
      "label": {
        "ru": "Заголовок страницы",
        "en": "Page title"
      },
      "kind": "page-title",
      "confidence": "observed"
    },
    "rn": {
      "label": {
        "ru": "Случайное число запроса",
        "en": "Random number for this request"
      },
      "kind": "nonce",
      "confidence": "observed"
    },
    "wmode": {
      "label": {
        "ru": "Режим отправки",
        "en": "Sending mode"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "u": {
      "label": {
        "ru": "Идентификатор вашего браузера",
        "en": "Your browser identifier"
      },
      "kind": "device-id",
      "confidence": "observed",
      "note": {
        "ru": "Берётся из куки _ym_uid, живёт два года и связывает все ваши визиты",
        "en": "Taken from the _ym_uid cookie, lives two years and ties together all your visits"
      }
    },
    "uid": {
      "label": {
        "ru": "Ваш идентификатор в системе сайта",
        "en": "Your identifier in the site’s own system"
      },
      "kind": "user-id",
      "confidence": "observed"
    },
    "s": {
      "label": {
        "ru": "Разрешение экрана и глубина цвета",
        "en": "Screen resolution and colour depth"
      },
      "kind": "screen",
      "confidence": "observed"
    },
    "w": {
      "label": {
        "ru": "Размер окна браузера",
        "en": "Browser window size"
      },
      "kind": "screen",
      "confidence": "observed"
    },
    "z": {
      "label": {
        "ru": "Часовой пояс, минут от UTC",
        "en": "Time zone, minutes from UTC"
      },
      "kind": "timezone",
      "confidence": "observed"
    },
    "la": {
      "label": {
        "ru": "Язык браузера",
        "en": "Browser language"
      },
      "kind": "language",
      "confidence": "observed"
    },
    "en": {
      "label": {
        "ru": "Кодировка",
        "en": "Character encoding"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "c": {
      "label": {
        "ru": "Разрешены ли куки",
        "en": "Whether cookies are allowed"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "ln": {
      "label": {
        "ru": "Язык интерфейса системы",
        "en": "System interface language"
      },
      "kind": "language",
      "confidence": "observed"
    },
    "pv": {
      "label": {
        "ru": "Просмотр страницы",
        "en": "Page view"
      },
      "kind": "event-name",
      "confidence": "observed"
    },
    "ar": {
      "label": {
        "ru": "Признак повторного визита",
        "en": "Returning visit flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "vf": {
      "label": {
        "ru": "Метка визита",
        "en": "Visit marker"
      },
      "kind": "session-id",
      "confidence": "observed"
    },
    "et": {
      "label": {
        "ru": "Время отправки",
        "en": "Time of sending"
      },
      "kind": "timing",
      "confidence": "observed"
    },
    "st": {
      "label": {
        "ru": "Секунд с начала визита",
        "en": "Seconds since the visit began"
      },
      "kind": "timing",
      "confidence": "observed"
    },
    "ds": {
      "label": {
        "ru": "Тайминги загрузки страницы",
        "en": "Page load timings"
      },
      "kind": "timing",
      "confidence": "observed"
    },
    "nsr": {
      "label": {
        "ru": "Признак отсутствия перехода",
        "en": "No-referrer flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "fp": {
      "label": {
        "ru": "Время первой отрисовки",
        "en": "Time of first paint"
      },
      "kind": "timing",
      "confidence": "observed"
    },
    "cn": {
      "label": {
        "ru": "Номер обращения",
        "en": "Request number"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "rqnl": {
      "label": {
        "ru": "Признак сетевой доступности",
        "en": "Network availability flag"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "ti": {
      "label": {
        "ru": "Номер обращения в визите",
        "en": "Request number within the visit"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "adb": {
      "label": {
        "ru": "Обнаружен ли блокировщик рекламы",
        "en": "Whether an ad blocker was detected"
      },
      "kind": "technical",
      "confidence": "observed"
    },
    "ds1": {
      "label": {
        "ru": "Дополнительные тайминги",
        "en": "Additional timings"
      },
      "kind": "timing",
      "confidence": "observed"
    }
  },
  "unknown": "preserve"
}
